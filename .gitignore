# ==========================================
# GoRide Monorepo - Git Ignore Configuration
# ==========================================

# Compiled class and build output
target/
*.class
*.jar
*.war
*.ear
*.zip
*.tar.gz
*.rar

# Maven
.mvn/timing.properties
.mvn/wrapper/maven-wrapper.jar

# JVM crash logs
hs_err_pid*
replay_pid*

# IntelliJ IDEA
.idea/
*.iml
*.iws
*.ipr
out/

# Eclipse
.project
.classpath
.settings/
bin/

# Visual Studio Code
.vscode/
*.code-workspace

# NetBeans
nbproject/private/
build/
nbbuild/
dist/
nbdist/
.nb-gradle/

# Operating System files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# Environment and Secrets (CRITICAL: Never commit real credentials)
.env
.env.local
.env.*.local
*.pem
*.key
*.p12
*.jks

# Node / Frontend (React + Vite)
frontend/demo-client/node_modules/
frontend/demo-client/dist/
frontend/demo-client/.vite/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Logs and runtime artifacts
logs/
*.log
*.pid

# Temporary and Scratch files
tmp/
temp/
scratch/
