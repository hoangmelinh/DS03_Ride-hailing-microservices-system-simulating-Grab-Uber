# ==============================================================================
# GoRide Distributed System - Environment Variables Template
# Copy this file to .env before starting the services locally or via Docker.
# DO NOT COMMIT THE ACTUAL .env FILE CONTAINING SENSITIVE DATA.
# ==============================================================================

# System Environment
ENVIRONMENT=local
LOG_LEVEL=INFO

# PostgreSQL Configuration (One logical database per microservice)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=goride_admin
POSTGRES_PASSWORD=goride_dev_password

DB_USER_NAME=goride_user
DB_DRIVER_NAME=goride_driver
DB_TRIP_NAME=goride_trip
DB_MATCHING_NAME=goride_matching
DB_PAYMENT_NAME=goride_payment
DB_NOTIFICATION_NAME=goride_notification

# RabbitMQ Configuration
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_EXCHANGE=goride.events

# Redis Configuration (Matching projection & GEO index)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT Authentication
JWT_SECRET_KEY=dev_secret_key_change_in_production_min_256_bits_for_hmac_or_use_rs256_key
JWT_EXPIRATION_SECONDS=86400

# Service Ports (Local development)
API_GATEWAY_PORT=8080
USER_SERVICE_PORT=8081
DRIVER_SERVICE_PORT=8082
TRIP_SERVICE_PORT=8083
MATCHING_SERVICE_PORT=8084
PAYMENT_SERVICE_PORT=8085
NOTIFICATION_SERVICE_PORT=8086

# Observability (Prometheus, Grafana, Jaeger)
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
JAEGER_UI_PORT=16686
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
